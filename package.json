{
  "name": "overlapping-generations",
  "version": "0.1.0",
  "description": "TypeScript simulation of energy transitions, demographics, debt, and climate (2025-2100), built on the tsimulation framework.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "build:framework": "npm run build --workspace tsimulation",
    "start": "npx tsx src/simulation.ts",
    "test:framework": "npm test --workspace tsimulation",
    "test:core": "npx tsc --noEmit && find src -name '*.test.ts' -print | sort | while read -r f; do echo \"Running $f\"; node --import tsx \"$f\" || exit 1; done",
    "aging:status": "node --import tsx aging-places/scripts/international-status.ts",
    "preaging:global-city": "npm run build:framework",
    "aging:global-city": "node --import tsx aging-places/scripts/global-city.ts",
    "test:aging": "npm run aging:status && npx tsc --noEmit -p aging-places/tsconfig.json && find aging-places -name '*.test.ts' -print | sort | while read -r f; do echo \"Running $f\"; node --import tsx \"$f\" || exit 1; done",
    "pretest": "npm run build:framework",
    "test": "npm run test:framework && npm run test:core && npm run test:aging",
    "precapture-baseline": "npm run build:framework",
    "capture-baseline": "npx tsx scripts/baseline.ts --output=baselines/current.json",
    "regression": "npm run capture-baseline && npx tsx scripts/compare-baselines.ts --strict baselines/reference.json baselines/current.json",
    "bless-baseline": "npx tsx scripts/bless-baseline.ts",
    "sim:new": "node --import tsx scripts/new-simulations-suite.ts",
    "aviation:infrastructure": "node --import tsx scripts/aviation-infrastructure-scenario.ts",
    "aviation:bay-pj": "node --import tsx scripts/bay-area-private-jet-scenario.ts",
    "ebike:motors": "node --import tsx scripts/e-bike-motor-market.ts",
    "trade:build-network": "node --import tsx scripts/build-trade-network-snapshot.ts",
    "trade:calibrate-network": "node --import tsx scripts/calibrate-trade-diversion.ts",
    "trade:network": "node --import tsx scripts/trade-network-tariff-scenario.ts",
    "news:2026-07-24": "node --import tsx scripts/headlines-2026-07-24.ts",
    "news:2026-07-25": "node --import tsx scripts/headlines-2026-07-25.ts",
    "news:2026-07-26": "node --import tsx scripts/headlines-2026-07-26.ts",
    "news:2026-07-27": "node --import tsx scripts/headlines-2026-07-27.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tsimulation": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
