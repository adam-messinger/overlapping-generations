  {
   "id": "q3",
   "status": "directional",
   "label": "US 10y TIPS 2035 average",
   "note": "economy-wide real lending rate; use the change across runs, never the level",
   "readings": [
    {
     "label": "real lending rate change 2026->2035, pp",
     "field": "interestRate",
     "transform": "delta",
     "from": 2026,
     "to": 2035,
     "scale": 100
    },
    {
     "label": "debt risk premium 2035, pp",
     "field": "debtRiskPremium",
     "transform": "level",
     "year": 2035,
     "scale": 100
    }
   ]
  },
  {
   "id": "q4",
   "status": "directional",
   "label": "US net interest >= 4.5% GDP FY2035",
   "note": "world aggregate public interest / world GDP; sign and size of change only",
