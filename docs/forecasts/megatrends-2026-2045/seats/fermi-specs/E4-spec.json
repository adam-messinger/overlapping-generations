    {
     "label": "world public interest / GDP 2035, %",
     "field": "publicInterestPayments",
     "denominatorField": "gdp",
     "transform": "ratio",
     "year": 2035,
     "scale": 100
    },
    {
     "label": "world public debt / GDP 2035",
     "field": "publicDebtGDP",
     "transform": "level",
     "year": 2035
    }
   ]
  },
